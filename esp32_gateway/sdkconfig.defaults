# Baseline Phase 4 cho ESP32 classic. Pin thật phải đối chiếu board trước khi cấp nguồn.
CONFIG_AEGIS_AS32_UART_PORT=2
CONFIG_AEGIS_AS32_UART_BAUD=9600
CONFIG_AEGIS_AS32_TX_PIN=17
CONFIG_AEGIS_AS32_RX_PIN=16
CONFIG_AEGIS_AS32_MD0_PIN=25
CONFIG_AEGIS_AS32_MD1_PIN=26
CONFIG_AEGIS_AS32_AUX_PIN=27
CONFIG_AEGIS_PHASE4_ROUNDS=20
